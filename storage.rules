rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // profile-pictures/{userId}/... — only that user can upload/overwrite their own avatar.
    // Publicly readable so avatars render on posts/feed for everyone.
    match /profile-pictures/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024 // 5MB max
                   && request.resource.contentType.matches('image/.*');
    }

    // posts/{userId}/... — only that user can upload images for their own posts.
    // Publicly readable since posts are public (Task 3 homepage feed).
    match /posts/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 8 * 1024 * 1024 // 8MB max
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
